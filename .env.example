# ---------------------------------------------------------------------------
# Echoes - local configuration template
#
# Copy to .env and fill in real values:   cp .env.example .env
#
# .env is gitignored and must never be committed. On GitHub Actions this file
# is absent entirely - the workflow injects the same variable names from
# repository secrets, so application code cannot tell the two apart.
#
# Every value marked GITHUB SECRET below must also be added under
#   Settings -> Secrets and variables -> Actions -> New repository secret
# ---------------------------------------------------------------------------

# --- Notion ----------------------------------------------------------------
# GITHUB SECRET. Internal integration token from https://www.notion.so/my-integrations
# Remember to share both databases with the integration, or queries return empty.
NOTION_API_KEY=ntn_REPLACE_ME_EXAMPLE_TOKEN_1234567890

# GITHUB SECRET. The 32-character database id from the database URL:
# https://www.notion.so/<workspace>/<DATABASE_ID>?v=<view_id>
NOTION_BOOKS_DATABASE_ID=11111111111111111111111111111111
NOTION_ME_SECTION_DATABASE_ID=22222222222222222222222222222222

# Notion API version pinned so a platform change cannot silently alter behaviour.
NOTION_API_VERSION=2022-06-28
NOTION_TIMEOUT_SECONDS=30
NOTION_MAX_RETRIES=3

# --- Source filters --------------------------------------------------------
# Books pool: Status = Completed AND Completion Date >= cutoff
NOTION_BOOKS_STATUS_PROPERTY=Status
NOTION_BOOKS_STATUS_VALUE=Completed
NOTION_BOOKS_DATE_PROPERTY=Completion Date
NOTION_BOOKS_COMPLETED_ON_OR_AFTER=2024-04-24

# Standalone pool: pages in The Me Section tagged "Quote".
# Tag another page "Quote" in Notion and it is picked up automatically.
NOTION_ME_SECTION_TAG_PROPERTY=Tags
NOTION_ME_SECTION_TAG_VALUE=Quote

# --- Playlist --------------------------------------------------------------
# Two book quotes plus one standalone quote per day.
QUOTES_PER_DAY_BOOKS=2
QUOTES_PER_DAY_STANDALONE=1
# Used when the standalone pool holds no quotes at all.
QUOTES_PER_DAY_BOOKS_FALLBACK=3

# Set to an integer to make shuffling reproducible (useful when testing).
# Leave empty in production so each cycle is genuinely shuffled.
RANDOM_SEED=

# --- Formatting ------------------------------------------------------------
# "<quote> - Book Name"
BOOK_SEPARATOR=" - "
# "<quote> — Author", used when a callout has an attribution line beneath it.
ATTRIBUTION_SEPARATOR=" — "

# --- Delivery --------------------------------------------------------------
# console = print the message - switch to this explicitly while you don't yet
#           have the EMAIL_* values below filled in
# email   = send through Gmail SMTP, threaded as one ongoing conversation - the default
DELIVERY_MODE=email

# --- Email delivery (DELIVERY_MODE=email) -----------------------------------
# No business/template approval needed - just a Gmail account and an App
# Password (Google Account -> Security -> App Passwords, requires 2FA on).
# GITHUB SECRET (both).
EMAIL_FROM_ADDRESS=you@gmail.com
EMAIL_APP_PASSWORD=REPLACE_ME_EXAMPLE_APP_PASSWORD
# GITHUB SECRET. Where the daily digest goes.
EMAIL_TO_ADDRESS=recipient@example.com

# Must stay constant across every send - Gmail uses it (plus the
# In-Reply-To/References headers set automatically at send time) to keep
# every day's message in one ongoing thread instead of a new conversation
# each day. Changing it starts a new thread.
EMAIL_SUBJECT=Echoes — Daily Quotes
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_TIMEOUT_SECONDS=30

# --- Operational -----------------------------------------------------------
TIMEZONE=Asia/Kolkata
STATE_DIR=state
LOG_LEVEL=INFO

# Do everything except sending messages and writing state.
DRY_RUN=false

ALERTS_ENABLED=true
SUNDAY_REFRESH_ENABLED=true
# 0 = Monday ... 6 = Sunday
REFRESH_WEEKDAY=6
